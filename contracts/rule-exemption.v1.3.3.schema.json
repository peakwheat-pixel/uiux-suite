{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/rule-exemption.v1.3.3.schema.json",
  "title": "UIUX Rule Exemption V1.3.3",
  "type": "object",
  "required": ["rule_id", "scope", "reason", "owner", "approved_by", "created_at", "expires_at"],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^UX-[A-Z0-9]{2,6}-[0-9]{3}$"},
    "scope": {"$ref": "common.v1.3.3.schema.json#/$defs/relative_locator"},
    "reason": {"type": "string", "minLength": 10},
    "owner": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "common.v1.3.3.schema.json#/$defs/iso8601"},
    "expires_at": {"$ref": "common.v1.3.3.schema.json#/$defs/iso8601"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "ticket": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
