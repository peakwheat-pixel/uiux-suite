{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/review-attestation.v1.3.5.schema.json",
  "title": "UIUX Review Attestation V1.3.5",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "reviewed_head",
    "source_fingerprint",
    "builder_context_ref",
    "reviewer_context_ref",
    "review_origin",
    "isolation_level",
    "read_only_proof",
    "tool_digest",
    "evidence_manifest_hash",
    "source_unchanged",
    "verdict",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.v1.3.5.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.v1.3.5.schema.json#/$defs/run_id"
    },
    "reviewed_head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$"
        },
        {
          "$ref": "common.v1.3.5.schema.json#/$defs/sha256"
        }
      ]
    },
    "source_fingerprint": {
      "$ref": "common.v1.3.5.schema.json#/$defs/source_fingerprint"
    },
    "builder_context_ref": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_context_ref": {
      "type": "string",
      "minLength": 1
    },
    "review_origin": {
      "type": "object",
      "required": [
        "host",
        "launched_by",
        "verified_identity",
        "trust_source"
      ],
      "properties": {
        "host": {
          "enum": [
            "dsh",
            "codex",
            "claude-code",
            "zcode",
            "antigravity",
            "qoder",
            "generic",
            "ci"
          ]
        },
        "launched_by": {
          "type": "string",
          "minLength": 1
        },
        "verified_identity": {
          "type": "string",
          "minLength": 1
        },
        "trust_source": {
          "enum": [
            "none",
            "user_attested",
            "host_verified",
            "external_system"
          ]
        }
      },
      "additionalProperties": false
    },
    "isolation_level": {
      "enum": [
        "UNVERIFIED",
        "SELFTEST",
        "ISOLATED_SESSION",
        "INDEPENDENT_AGENT"
      ]
    },
    "read_only_proof": {
      "type": "object",
      "required": [
        "enforced",
        "method",
        "evidence_ref"
      ],
      "properties": {
        "enforced": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "acl",
            "sandbox",
            "readonly_mount",
            "process_policy",
            "none"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "tool_digest": {
      "$ref": "common.v1.3.5.schema.json#/$defs/sha256"
    },
    "evidence_manifest_hash": {
      "$ref": "common.v1.3.5.schema.json#/$defs/sha256"
    },
    "source_unchanged": {
      "type": "boolean"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "UNVERIFIED"
      ]
    },
    "dissent": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewed_at": {
      "$ref": "common.v1.3.5.schema.json#/$defs/iso8601"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "isolation_level": {
            "const": "INDEPENDENT_AGENT"
          }
        },
        "required": [
          "isolation_level"
        ]
      },
      "then": {
        "properties": {
          "review_origin": {
            "properties": {
              "trust_source": {
                "enum": [
                  "host_verified",
                  "external_system"
                ]
              }
            }
          },
          "source_unchanged": {
            "const": true
          },
          "read_only_proof": {
            "properties": {
              "enforced": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "isolation_level": {
            "const": "ISOLATED_SESSION"
          }
        },
        "required": [
          "isolation_level"
        ]
      },
      "then": {
        "properties": {
          "review_origin": {
            "properties": {
              "trust_source": {
                "enum": [
                  "host_verified",
                  "external_system",
                  "user_attested"
                ]
              }
            }
          },
          "source_unchanged": {
            "const": true
          }
        }
      }
    }
  ]
}
