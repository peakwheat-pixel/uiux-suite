{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/confusion-matrix.v1.3.3.schema.json",
  "title": "UIUX Stage 1 Confusion Matrix V1.3.3",
  "type": "object",
  "required": ["schema_version", "suite", "generated_at", "matrix", "per_rule", "samples"],
  "properties": {
    "schema_version": {"$ref": "common.v1.3.3.schema.json#/$defs/schema_version"},
    "suite": {"type": "string", "minLength": 1},
    "git_commit": {"type": ["string", "null"]},
    "generated_at": {"$ref": "common.v1.3.3.schema.json#/$defs/iso8601"},
    "matrix": {
      "type": "object",
      "required": ["tp", "fp", "tn", "fn"],
      "properties": {
        "tp": {"type": "integer", "minimum": 0},
        "fp": {"type": "integer", "minimum": 0},
        "tn": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "per_rule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "tp", "fp", "tn", "fn"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^UX-[A-Z0-9]{2,6}-[0-9]{3}$"},
          "tp": {"type": "integer", "minimum": 0},
          "fp": {"type": "integer", "minimum": 0},
          "tn": {"type": "integer", "minimum": 0},
          "fn": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sample_id", "expected", "actual", "status"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "expected": {"type": "array", "items": {"type": "string"}},
          "actual": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["TP", "FP", "TN", "FN", "PARTIAL"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
