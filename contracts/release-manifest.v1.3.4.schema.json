{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/release-manifest.v1.3.4.schema.json",
  "title": "UIUX Release Manifest V1.3.4",
  "type": "object",
  "required": [
    "schema_version",
    "suite_version",
    "generated_at",
    "builder",
    "target_platform",
    "normalization",
    "files",
    "excluded_patterns",
    "include_launcher",
    "include_schemas",
    "include_licenses",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.v1.3.4.schema.json#/$defs/schema_version"
    },
    "suite_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "$ref": "common.v1.3.4.schema.json#/$defs/iso8601"
    },
    "builder": {
      "type": "string",
      "minLength": 1
    },
    "target_platform": {
      "type": "object",
      "required": [
        "os",
        "python",
        "node"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "normalization": {
      "type": "object",
      "required": [
        "path_separator",
        "case_policy",
        "eol_normalized"
      ],
      "properties": {
        "path_separator": {
          "const": "/"
        },
        "case_policy": {
          "enum": [
            "case_sensitive",
            "casefolded_windows"
          ]
        },
        "eol_normalized": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size",
          "role"
        ],
        "properties": {
          "path": {
            "$ref": "common.v1.3.4.schema.json#/$defs/rel_path"
          },
          "sha256": {
            "$ref": "common.v1.3.4.schema.json#/$defs/sha256"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "runtime",
              "schema",
              "launcher",
              "skill",
              "knowledge",
              "docs",
              "license",
              "other"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "excluded_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "include_launcher": {
      "type": "boolean"
    },
    "include_schemas": {
      "type": "boolean"
    },
    "include_licenses": {
      "type": "boolean"
    },
    "bundle_sha256": {
      "$ref": "common.v1.3.4.schema.json#/$defs/sha256"
    }
  },
  "additionalProperties": false
}
