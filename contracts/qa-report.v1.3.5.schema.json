{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/qa-report.v1.3.5.schema.json",
  "title": "UIUX QA Safety Metrics Report V1.3.5",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "runs",
    "summary",
    "ok"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.v1.3.5.schema.json#/$defs/schema_version"
    },
    "generated_at": {
      "$ref": "common.v1.3.5.schema.json#/$defs/iso8601"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "mode",
          "status",
          "real_user_data_writes",
          "protected_root_writes",
          "blocked_actions"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "real_user_data_writes": {
            "type": "integer",
            "minimum": 0
          },
          "protected_root_writes": {
            "type": "integer",
            "minimum": 0
          },
          "blocked_actions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "real_user_data_writes",
        "protected_root_writes",
        "blocked_actions",
        "zero_write"
      ],
      "properties": {
        "real_user_data_writes": {
          "type": "integer",
          "minimum": 0
        },
        "protected_root_writes": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_actions": {
          "type": "integer",
          "minimum": 0
        },
        "zero_write": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ok": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
