{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/change-plan.v1.3.5.schema.json",
  "title": "UIUX Controlled Change Plan V1.3.5",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "created_at",
    "write_scope",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.v1.3.5.schema.json#/$defs/schema_version"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "common.v1.3.5.schema.json#/$defs/iso8601"
    },
    "write_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.v1.3.5.schema.json#/$defs/rel_path"
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "action"
        ],
        "properties": {
          "path": {
            "$ref": "common.v1.3.5.schema.json#/$defs/rel_path"
          },
          "action": {
            "enum": [
              "create",
              "modify",
              "delete"
            ]
          },
          "sha256_before": {
            "$ref": "common.v1.3.5.schema.json#/$defs/sha256"
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
