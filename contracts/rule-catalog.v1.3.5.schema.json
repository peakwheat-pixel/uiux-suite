{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/rule-catalog.v1.3.5.schema.json",
  "title": "UIUX Rule Catalog V1.3.5",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_version",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.v1.3.5.schema.json#/$defs/schema_version"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "frozen_at": {
      "$ref": "common.v1.3.5.schema.json#/$defs/iso8601"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "rule_id",
        "title",
        "category",
        "severity",
        "detector",
        "scope",
        "description",
        "remediation",
        "evidence_kind",
        "enabled"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^UX-[A-Z0-9]{2,6}-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "enum": [
            "COLOR",
            "TYPE",
            "SPACE",
            "FLOW",
            "GEOM",
            "A11Y",
            "COPY",
            "STATE",
            "MOTION"
          ]
        },
        "severity": {
          "enum": [
            "FAIL",
            "WARNING",
            "INFO"
          ]
        },
        "detector": {
          "enum": [
            "style_token_linter",
            "ux_flow_validator",
            "layout_geometry_probe",
            "accessibility_checker"
          ]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "web",
              "tauri",
              "qt",
              "winui",
              "wpf",
              "flows",
              "any"
            ]
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "enum": [
            "screenshot",
            "dom_snapshot",
            "uia_tree",
            "test_log",
            "tool_log",
            "diff",
            "hash_manifest",
            "design_review",
            "coverage_matrix",
            "other"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
