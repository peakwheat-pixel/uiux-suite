{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/component-matrix.v1.3.3.schema.json",
  "title": "UIUX Component and State Matrix V1.3.3",
  "type": "object",
  "required": ["schema_version", "view_id", "components", "state_coverage", "summary"],
  "properties": {
    "schema_version": {"$ref": "common.v1.3.3.schema.json#/$defs/schema_version"},
    "view_id": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "source", "states", "covered_states", "gaps"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.v1.3.3.schema.json#/$defs/rel_path"},
          "states": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "covered_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "gaps": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "state_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "covered", "components"],
        "properties": {
          "state": {"type": "string", "minLength": 1},
          "covered": {"type": "boolean"},
          "components": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["components", "states", "covered", "gaps"],
      "properties": {
        "components": {"type": "integer", "minimum": 0},
        "states": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "gaps": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
