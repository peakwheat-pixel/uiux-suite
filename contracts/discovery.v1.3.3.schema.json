{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/discovery.v1.3.3.schema.json",
  "title": "UIUX Discovery Report V1.3.3",
  "type": "object",
  "required": ["schema_version", "view_id", "generated_at", "sources", "pages", "capabilities", "capability_evidence"],
  "properties": {
    "schema_version": {"$ref": "common.v1.3.3.schema.json#/$defs/schema_version"},
    "view_id": {"type": "string", "minLength": 1},
    "generated_at": {"$ref": "common.v1.3.3.schema.json#/$defs/iso8601"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "status"],
        "properties": {
          "source": {"enum": ["source", "runtime", "contract"]},
          "status": {"enum": ["OBSERVED", "UNVERIFIED", "MISSING"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_id", "kind", "route", "source", "archetype", "confidence"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["page", "route", "modal", "dialog", "panel", "window", "canvas"]},
          "route": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "required": ["file", "line"],
            "properties": {
              "file": {"$ref": "common.v1.3.3.schema.json#/$defs/rel_path"},
              "line": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "archetype": {"enum": ["modal_form", "consumer_view", "data_table", "desktop_workbench", "canvas_editor"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "capabilities": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["async_load", "collection_display", "user_mutation", "long_running_task", "destructive_operations"],
      "properties": {
        "async_load": {"type": "boolean"},
        "collection_display": {"type": "boolean"},
        "user_mutation": {"type": "boolean"},
        "long_running_task": {"type": "boolean"},
        "destructive_operations": {"type": "boolean"},
        "canvas_rendering": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "capability_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "source", "discovery", "confidence"],
        "properties": {
          "capability": {"enum": ["async_load", "collection_display", "user_mutation", "long_running_task", "destructive_operations", "canvas_rendering"]},
          "source": {
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": {"enum": ["file", "anchor", "task", "runtime"]},
              "ref": {"type": "string", "minLength": 1},
              "locator": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "discovery": {"enum": ["static", "runtime", "contract"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "unverified_paths": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
