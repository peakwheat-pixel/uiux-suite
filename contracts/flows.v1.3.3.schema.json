{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/flows.v1.3.3.schema.json",
  "title": "UIUX Flow Contract V1.3.3",
  "type": "object",
  "required": [
    "schema_version", "view_id", "view_archetype", "capabilities",
    "capability_evidence", "tasks", "ui_anchors"
  ],
  "properties": {
    "schema_version": {"$ref": "common.v1.3.3.schema.json#/$defs/schema_version"},
    "view_id": {"type": "string", "minLength": 1},
    "view_archetype": {"enum": ["modal_form", "consumer_view", "data_table", "desktop_workbench", "canvas_editor"]},
    "capabilities": {
      "type": "object",
      "required": ["async_load", "collection_display", "user_mutation", "long_running_task", "destructive_operations"],
      "properties": {
        "async_load": {"type": "boolean"},
        "collection_display": {"type": "boolean"},
        "user_mutation": {"type": "boolean"},
        "long_running_task": {"type": "boolean"},
        "destructive_operations": {"type": "boolean"},
        "canvas_rendering": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "capability_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "source", "discovery", "confidence"],
        "properties": {
          "capability": {"enum": ["async_load", "collection_display", "user_mutation", "long_running_task", "destructive_operations", "canvas_rendering"]},
          "source": {
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": {"enum": ["file", "anchor", "task", "runtime"]},
              "ref": {"type": "string", "minLength": 1},
              "locator": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "discovery": {"enum": ["static", "runtime", "contract"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "actor_goal", "entry_point", "steps", "states", "runtime_assertions", "destructive_operations"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "actor_goal": {"type": "string", "minLength": 1},
          "entry_point": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "states": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "runtime_assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["assertion_id", "description", "expected_states"],
              "properties": {
                "assertion_id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "expected_states": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "probe_id": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          },
          "destructive_operations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["operation_id", "description", "irreversible", "guard"],
              "properties": {
                "operation_id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "irreversible": {"type": "boolean"},
                "guard": {"enum": ["confirmation", "undo", "both", "none"]},
                "evidence_refs": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "ui_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["semantic_id", "testid"],
        "properties": {
          "semantic_id": {"type": "string", "minLength": 1},
          "testid": {"type": ["string", "null"]},
          "selector": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
