{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/contracts/tool-log.v1.3.4.schema.json",
  "title": "UIUX Tool Log V1.3.4",
  "type": "object",
  "required": [
    "schema_version",
    "log_id",
    "run_id",
    "tool",
    "tool_version",
    "command",
    "cwd",
    "input_digest",
    "output_digest",
    "exit_code",
    "started_at",
    "finished_at",
    "execution_level",
    "probe_id",
    "log_sha256",
    "redaction"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.v1.3.4.schema.json#/$defs/schema_version"
    },
    "log_id": {
      "type": "string",
      "pattern": "^TL-[A-Za-z0-9._-]+$"
    },
    "run_id": {
      "$ref": "common.v1.3.4.schema.json#/$defs/run_id"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "$ref": "common.v1.3.4.schema.json#/$defs/abs_path"
    },
    "env_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_digest": {
      "$ref": "common.v1.3.4.schema.json#/$defs/sha256"
    },
    "output_digest": {
      "$ref": "common.v1.3.4.schema.json#/$defs/sha256"
    },
    "exit_code": {
      "type": "integer"
    },
    "started_at": {
      "$ref": "common.v1.3.4.schema.json#/$defs/iso8601"
    },
    "finished_at": {
      "$ref": "common.v1.3.4.schema.json#/$defs/iso8601"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "execution_level": {
      "enum": [
        "NONE",
        "SIMULATED",
        "NATIVE_APP",
        "OS_INTEGRATION"
      ]
    },
    "probe_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "log_sha256": {
      "$ref": "common.v1.3.4.schema.json#/$defs/sha256"
    },
    "stdout_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "stderr_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "redaction": {
      "type": "object",
      "required": [
        "applied",
        "kinds"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "kinds": {
          "type": "array",
          "items": {
            "enum": [
              "path",
              "field",
              "image",
              "full"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
