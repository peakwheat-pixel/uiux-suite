{
  "schema_version": "1.3.3",
  "catalog_version": "1.0",
  "frozen_at": "2026-10-24T00:00:00+00:00",
  "rules": [
    {
      "rule_id": "UX-COLOR-001",
      "title": "正文文字对比度不足",
      "category": "COLOR",
      "severity": "FAIL",
      "detector": "accessibility_checker",
      "scope": ["web", "tauri", "qt", "winui", "wpf"],
      "description": "正文/关键标签与背景对比度低于 WCAG 2.2 AA 的 4.5:1。",
      "remediation": "调整前景/背景色或字重，使对比度 >= 4.5:1；大字可用 3:1。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["wcag22", "contrast"],
      "references": ["WCAG 2.2 SC 1.4.3"]
    },
    {
      "rule_id": "UX-COLOR-002",
      "title": "仅用颜色表达状态或错误",
      "category": "COLOR",
      "severity": "WARNING",
      "detector": "accessibility_checker",
      "scope": ["web", "tauri", "qt", "any"],
      "description": "状态/错误仅通过颜色区分，缺少图标、文本或形状编码。",
      "remediation": "增加图标/文本/形状等非颜色线索。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["wcag22", "color-only"],
      "references": ["WCAG 2.2 SC 1.4.1"]
    },
    {
      "rule_id": "UX-TYPE-001",
      "title": "正文字号过小",
      "category": "TYPE",
      "severity": "WARNING",
      "detector": "style_token_linter",
      "scope": ["web", "tauri", "qt"],
      "description": "正文或关键操作文字小于 12px（桌面端可读性风险）。",
      "remediation": "正文 >= 13px，说明文字 >= 12px；用 token 统一。",
      "evidence_kind": "dom_snapshot",
      "enabled": true,
      "tags": ["typography", "readability"]
    },
    {
      "rule_id": "UX-TYPE-002",
      "title": "正文行高过紧",
      "category": "TYPE",
      "severity": "WARNING",
      "detector": "style_token_linter",
      "scope": ["web", "tauri", "qt"],
      "description": "多行正文 line-height 小于 1.3，长文本可读性下降。",
      "remediation": "正文 line-height 1.4–1.6；标题可 1.2–1.3。",
      "evidence_kind": "dom_snapshot",
      "enabled": true,
      "tags": ["typography", "line-height"]
    },
    {
      "rule_id": "UX-SPACE-001",
      "title": "间距脱离 token 栅格",
      "category": "SPACE",
      "severity": "WARNING",
      "detector": "style_token_linter",
      "scope": ["web", "tauri", "qt"],
      "description": "margin/padding/gap 使用非 token 的任意值，导致视觉节奏不一致。",
      "remediation": "改用间距 token（4/8 栅格）；确需例外时登记豁免。",
      "evidence_kind": "diff",
      "enabled": true,
      "tags": ["spacing", "tokens"]
    },
    {
      "rule_id": "UX-SPACE-002",
      "title": "点击目标过小",
      "category": "SPACE",
      "severity": "FAIL",
      "detector": "layout_geometry_probe",
      "scope": ["web", "tauri", "qt", "winui", "wpf"],
      "description": "交互目标小于 24x24 CSS px（WCAG 2.2 AA 最低要求）。",
      "remediation": "扩大到 >= 24x24；推荐 44x44 或等效间距。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["wcag22", "target-size"],
      "references": ["WCAG 2.2 SC 2.5.8"]
    },
    {
      "rule_id": "UX-FLOW-001",
      "title": "存在从入口不可达的流程节点",
      "category": "FLOW",
      "severity": "FAIL",
      "detector": "ux_flow_validator",
      "scope": ["flows", "web", "tauri", "qt"],
      "description": "flows.json 中某状态/页面从入口不可达，或存在孤立节点。",
      "remediation": "补入口/导航路径，或从流程移除死节点。",
      "evidence_kind": "test_log",
      "enabled": true,
      "tags": ["flows", "reachability"]
    },
    {
      "rule_id": "UX-FLOW-002",
      "title": "破坏性操作缺少确认或撤销",
      "category": "FLOW",
      "severity": "FAIL",
      "detector": "ux_flow_validator",
      "scope": ["flows", "web", "tauri", "qt", "winui", "wpf"],
      "description": "删除/覆盖/发布等破坏性操作没有确认、撤销或等价保护。",
      "remediation": "增加确认对话框 + 明确后果，或提供撤销；批量操作需二次确认。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["flows", "destructive", "safety"]
    },
    {
      "rule_id": "UX-FLOW-003",
      "title": "列表/集合缺少空状态",
      "category": "FLOW",
      "severity": "WARNING",
      "detector": "ux_flow_validator",
      "scope": ["flows", "web", "tauri", "qt"],
      "description": "集合视图未定义空状态与下一步行动。",
      "remediation": "提供空状态说明、主行动与创建入口。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["flows", "empty-state"]
    },
    {
      "rule_id": "UX-FLOW-004",
      "title": "错误路径缺少恢复动作",
      "category": "FLOW",
      "severity": "FAIL",
      "detector": "ux_flow_validator",
      "scope": ["flows", "web", "tauri", "qt"],
      "description": "错误态只有提示，没有重试/返回/修正等恢复路径。",
      "remediation": "补重试、返回、保留输入或联系支持等恢复动作。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["flows", "error-recovery"]
    },
    {
      "rule_id": "UX-A11Y-001",
      "title": "交互元素缺少可访问名称",
      "category": "A11Y",
      "severity": "FAIL",
      "detector": "accessibility_checker",
      "scope": ["web", "tauri", "qt", "winui", "wpf"],
      "description": "按钮/输入/链接无可被辅助技术读取的名称。",
      "remediation": "补 label、aria-label、UIA Name 或可见文本。",
      "evidence_kind": "uia_tree",
      "enabled": true,
      "tags": ["wcag22", "name-role-value"],
      "references": ["WCAG 2.2 SC 4.1.2"]
    },
    {
      "rule_id": "UX-A11Y-002",
      "title": "键盘焦点陷阱",
      "category": "A11Y",
      "severity": "FAIL",
      "detector": "accessibility_checker",
      "scope": ["web", "tauri", "qt", "any"],
      "description": "焦点被困在组件内，无法用键盘离开。",
      "remediation": "修正 Tab 顺序；模态框关闭后归还焦点。",
      "evidence_kind": "tool_log",
      "enabled": true,
      "tags": ["wcag22", "keyboard"]
    },
    {
      "rule_id": "UX-A11Y-003",
      "title": "焦点不可见",
      "category": "A11Y",
      "severity": "FAIL",
      "detector": "accessibility_checker",
      "scope": ["web", "tauri", "qt", "any"],
      "description": "键盘焦点没有可见指示，或对比度不足。",
      "remediation": "使用清晰 focus ring（>=3:1 对比），不要全局 outline:none。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["wcag22", "focus-visible"]
    },
    {
      "rule_id": "UX-A11Y-004",
      "title": "标题层级跳跃",
      "category": "A11Y",
      "severity": "WARNING",
      "detector": "accessibility_checker",
      "scope": ["web", "tauri", "qt"],
      "description": "标题层级跳级（如 h1→h3），破坏阅读顺序。",
      "remediation": "按语义层级使用标题，视觉大小用样式控制。",
      "evidence_kind": "dom_snapshot",
      "enabled": true,
      "tags": ["wcag22", "headings"]
    },
    {
      "rule_id": "UX-GEOM-001",
      "title": "文本或容器被裁切",
      "category": "GEOM",
      "severity": "FAIL",
      "detector": "layout_geometry_probe",
      "scope": ["web", "tauri", "qt", "winui", "wpf"],
      "description": "文本/关键控件被容器裁切、溢出或不可见。",
      "remediation": "调整布局/换行/滚动；关键内容不得依赖省略号隐藏。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["layout", "clipping"]
    },
    {
      "rule_id": "UX-GEOM-002",
      "title": "交互目标重叠",
      "category": "GEOM",
      "severity": "FAIL",
      "detector": "layout_geometry_probe",
      "scope": ["web", "tauri", "qt", "winui", "wpf"],
      "description": "两个可点击区域重叠，导致误触。",
      "remediation": "分离点击区域或调整 z-index/间距。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["layout", "overlap"]
    },
    {
      "rule_id": "UX-COPY-001",
      "title": "错误提示缺少可执行下一步",
      "category": "COPY",
      "severity": "WARNING",
      "detector": "style_token_linter",
      "scope": ["web", "tauri", "qt", "any"],
      "description": "错误文案只描述失败，未说明用户可做什么。",
      "remediation": "给出原因 + 下一步（重试/修改/联系支持）。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["copy", "errors"]
    },
    {
      "rule_id": "UX-STATE-001",
      "title": "异步操作缺少加载态",
      "category": "STATE",
      "severity": "WARNING",
      "detector": "ux_flow_validator",
      "scope": ["flows", "web", "tauri", "qt"],
      "description": "异步请求/长任务没有 loading/进度反馈，用户可能重复提交。",
      "remediation": "补 loading、禁用重复提交、超时提示。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["state", "loading"]
    },
    {
      "rule_id": "UX-STATE-002",
      "title": "未保存修改缺少提示",
      "category": "STATE",
      "severity": "WARNING",
      "detector": "ux_flow_validator",
      "scope": ["flows", "web", "tauri", "qt"],
      "description": "有未保存修改时离开/关闭，没有确认或自动保存。",
      "remediation": "加脏状态提示、离开确认或自动保存。",
      "evidence_kind": "screenshot",
      "enabled": true,
      "tags": ["state", "dirty"]
    },
    {
      "rule_id": "UX-MOTION-001",
      "title": "未尊重减少动效偏好",
      "category": "MOTION",
      "severity": "WARNING",
      "detector": "style_token_linter",
      "scope": ["web", "tauri", "qt"],
      "description": "关键动画未响应 prefers-reduced-motion 或系统动效设置。",
      "remediation": "提供 reduced-motion 分支，去掉非必要动画。",
      "evidence_kind": "dom_snapshot",
      "enabled": true,
      "tags": ["a11y", "motion"]
    }
  ]
}
