    "max_repair_cycles": 2
  },
  "authorization": {
    "granted_by": "fixture-author",
    "granted_at": "2026-10-23T12:00:00+00:00",
    "expires_at": null,
    "scopes": [
      "production_write"
    ],
    "evidence_ref": "EV-AUTH"
  },
  "git": {
    "management": "standalone",
    "snapshot_policy": "git_commit"
  },
  "evidence": {
    "profile": "local_private",
    "retention_days": 30,
    "release_retention_days": 180
  },
  "allowed_modes": [
    "redesign"
  ],
  "created_at": "2026-10-23T12:00:00+00:00"
