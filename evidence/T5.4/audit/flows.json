  "capabilities": {
    "async_load": true,
    "collection_display": true,
    "user_mutation": true,
    "long_running_task": true,
    "destructive_operations": true,
    "canvas_rendering": true
  },
  "capability_evidence": [
    {
      "capability": "collection_display",
      "source": {
        "kind": "runtime",
        "ref": "bookshelf/bookshelf-list"
      },
      "discovery": "runtime",
      "confidence": 1.0,
      "detail": "真实应用书架列出合成作品与 3 页章节"
    },
    {
      "capability": "async_load",
      "source": {
        "kind": "runtime",
        "ref": "reader/reader-next-page-btn"
      },
      "discovery": "runtime",
      "confidence": 0.95,
      "detail": "阅读器翻页 1/3→3/3，页面图像按需加载"
    },
    {
      "capability": "user_mutation",
      "source": {
        "kind": "runtime",
        "ref": "region/set_region_type"
      },
      "discovery": "runtime",
      "confidence": 1.0,
      "detail": "region speech→sfx 产生 revision 2，restore revision 1 产生 revision 3"
    },
    {
      "capability": "long_running_task",
      "source": {
        "kind": "runtime",
        "ref": "pipeline/run"
      },
      "discovery": "runtime",
      "confidence": 0.9,
      "detail": "acceptance bridge translate_all run completed"
    },
    {
      "capability": "destructive_operations",
      "source": {
        "kind": "task",
        "ref": "workbench/export"
      },
      "discovery": "contract",
      "confidence": 0.8
    },
    {
      "capability": "canvas_rendering",
      "source": {
        "kind": "runtime",
        "ref": "workbench/viewer-stage"
      },
      "discovery": "runtime",
      "confidence": 0.95
    }
  ],
  "tasks": [
    {
      "task_id": "import-folder",
      "actor_goal": "导入本地漫画文件夹并看到页数",
      "entry_point": "bookshelf/import",
      "steps": [
        "open-import-dialog",
        "choose-folder",
        "confirm",
        "review-import-report"
      ],
      "states": [
        "empty",
        "ready",
        "loading",
        "error",
        "cancelled"
      ],
      "runtime_assertions": [
        {
          "assertion_id": "import-count-3",
          "description": "导入 3 页后作品页数为 3",
          "expected_states": [
            "ready"
          ],
          "probe_id": "P-G5"
        }
      ],
      "destructive_operations": []
    },
    {
      "task_id": "browse-and-read",
      "actor_goal": "从书架进入章节并按页阅读",
      "entry_point": "bookshelf/book-card",
      "steps": [
        "open-book",
        "open-chapter",
        "reader-next-page",
        "return"
      ],
      "states": [
        "loading",
        "ready",
        "error"
      ],
      "runtime_assertions": [
        {
          "assertion_id": "reader-1-to-3",
          "description": "阅读器从 1/3 翻到 3/3",
          "expected_states": [
            "ready"
          ],
          "probe_id": "P-G1"
        }
      ],
      "destructive_operations": []
    },
    {
      "task_id": "export-translated",
      "actor_goal": "将合法翻译产物导出为 PNG 与 ZIP",
      "entry_point": "workbench/export",
      "steps": [
        "select-page",
        "open-export",
        "choose-format",
        "export",
        "verify-file"
      ],
      "states": [
        "ready",
        "progress",
        "error",
        "done"
      ],
      "runtime_assertions": [
        {
          "assertion_id": "zip-export-completed",
          "description": "产品 ExportService 返回 COMPLETED 且 ZIP 含 2 页",
          "expected_states": [
            "done"
          ],
          "probe_id": "P-G5"
        }
      ],
      "destructive_operations": [
        {
          "operation_id": "overwrite-output",
          "description": "覆盖同名导出文件",
          "irreversible": false,
          "guard": "confirmation"
        }
      ]
    },
    {
      "task_id": "retype-and-undo",
      "actor_goal": "改标 region 并在 10 秒内恢复上一 revision",
      "entry_point": "workbench/region-inspector",
      "steps": [
        "select-region",
        "mark-sfx",
        "undo"
      ],
      "states": [
        "ready",
        "busy",
        "error",
        "restored"
      ],
      "runtime_assertions": [
        {
          "assertion_id": "restore-revision",
          "description": "restore_region_revision 将 speech/sfx 恢复为原 revision",
          "expected_states": [
            "restored"
          ],
          "probe_id": "P-U1"
        }
      ],
      "destructive_operations": []
    }
  ],
  "ui_anchors": [
    {
      "semantic_id": "bookshelf.import",
      "testid": "detail-import-btn"
    },
    {
      "semantic_id": "reader.next",
