{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-suite.local/inventory/schema/inventory.v1.schema.json",
  "title": "UIUX Declared-Scope Inventory V1.0",
  "type": "object",
  "required": ["schema_version", "inventory_id", "scope", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "inventory_id": {"type": "string", "pattern": "^INV-[A-Za-z0-9._-]{3,64}$"},
    "description": {"type": "string"},
    "scope": {
      "type": "object",
      "required": ["declared_scope_id", "included", "excluded", "source_binding", "risk_tier"],
      "properties": {
        "declared_scope_id": {"type": "string", "pattern": "^SCOPE-[A-Za-z0-9._-]{3,64}$"},
        "included": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_binding": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["git_commit", "dir_digest", "package_version"]},
            "value": {"type": "string", "minLength": 1},
            "fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        },
        "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "risk_tier": {"enum": ["P0", "P1", "P2", "P3"]},
        "frozen_at": {"type": "string", "format": "date-time"},
        "reviewed_by": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stable_id", "type", "risk_level", "applicability",
          "discovery_source", "declared_scope", "disposition"
        ],
        "properties": {
          "stable_id": {"type": "string", "pattern": "^ITM-[A-Za-z0-9._-]{1,64}$"},
          "type": {
            "enum": ["page", "region", "dialog", "menu", "flow", "entrypoint", "state_machine", "command"]
          },
          "risk_level": {"enum": ["P0", "P1", "P2", "P3"]},
          "applicability": {"enum": ["applicable", "not_applicable", "unknown"]},
          "discovery_source": {"enum": ["static_scan", "runtime_probe", "manual", "issue_reference"]},
          "declared_scope": {"enum": ["included", "excluded"]},
          "disposition": {"enum": ["mapped", "unmapped", "excluded"]},
          "evidence_reference": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
